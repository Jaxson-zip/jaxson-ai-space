{
  "name": "jaxson-ai-space",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @jaxson/web --filter @jaxson/portfolio dev",
    "dev:cms": "pnpm --filter @jaxson/web dev",
    "dev:portfolio": "pnpm --filter @jaxson/portfolio dev",
    "build": "pnpm --filter @jaxson/web build && pnpm --filter @jaxson/portfolio build",
    "start": "pnpm --parallel --filter @jaxson/web --filter @jaxson/portfolio start",
    "lint": "pnpm --filter @jaxson/web lint",
    "test": "pnpm --filter @jaxson/web test && pnpm --filter @jaxson/portfolio test",
    "typecheck": "pnpm --filter @jaxson/web typecheck"
  }
}
