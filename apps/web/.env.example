# =========================================================================
# Jaxson AI Space Web Environment Configuration
# =========================================================================

# Database Engine Switch (set to true for PostgreSQL + pgvector; false for SQLite local dev)
USE_POSTGRES=true
DATABASE_URI=postgresql://owner_app:jaxson_secure_dev_password_2026@127.0.0.1:5432/jaxson_space
PUBLIC_AGENT_DATABASE_URI=postgresql://public_agent:public_agent_dev_password_2026@127.0.0.1:5432/jaxson_space

# Payload CMS Secret (Mandatory in production, minimum 32 chars)
PAYLOAD_SECRET=dev-only-change-before-deploy-32-characters-long

# Studio Workbench & OpenClaw Webhook Secret Keys
STUDIO_SECRET_KEY=jaxson_studio_secret_2026_super_key
STUDIO_INBOX_SECRET=jaxson_studio_inbox_token_2026

# Owner Identity & Cloudflare Zero Trust Verification
OWNER_EMAIL=1822103245@qq.com
ENFORCE_STUDIO_AUTH=false
CLOUDFLARE_ACCESS_TEAM_NAME=jaxson-space
CLOUDFLARE_ACCESS_AUD=your-cloudflare-access-audience-tag
# CLOUDFLARE_ACCESS_SECRET=your-hs256-signing-secret
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Base Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional External LLM Integration Keys
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

