# =========================================================================
# Jaxson AI Space Web Environment Configuration
# =========================================================================

# Database Engine Switch (set to true for PostgreSQL + pgvector; false for SQLite local dev)
USE_POSTGRES=false
DATABASE_URI=
PUBLIC_AGENT_DATABASE_URI=

# Payload CMS Secret (Mandatory in production, minimum 32 chars)
PAYLOAD_SECRET=

# Studio Workbench & OpenClaw Webhook Secret Keys
STUDIO_SECRET_KEY=
STUDIO_INBOX_SECRET=
# JSON array of exact channel/account/sender triples; empty disables bot ingestion.
STUDIO_INBOX_ALLOWED_IDENTITIES=[]

# Owner Identity & Cloudflare Zero Trust Verification
OWNER_EMAIL=1822103245@qq.com
ENFORCE_STUDIO_AUTH=false
CLOUDFLARE_ACCESS_TEAM_NAME=jaxson-space
CLOUDFLARE_ACCESS_AUD=your-cloudflare-access-audience-tag
CLOUDFLARE_ACCESS_REQUIRED=false
# CLOUDFLARE_ACCESS_SECRET=your-hs256-signing-secret
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Base Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000

# Optional External LLM Integration Keys
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash
# DASHSCOPE_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# Shared query/index embedding configuration. semantic mode requires a dedicated key.
EMBEDDING_MODE=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=5000

# Optional SMTP transport for CMS password recovery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Jaxson

