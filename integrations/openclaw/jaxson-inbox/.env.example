# Set these in the OpenClaw Gateway process, not in the public portfolio.
SPACE_BOT_BASE_URL=http://127.0.0.1:3001
SPACE_BOT_SECRET=
# Must match the backend exactly. Replace IDs with the channel's actual values.
STUDIO_INBOX_ALLOWED_IDENTITIES=[]
JAXSON_FORWARD_TIMEOUT_MS=4000
# Optional external Todo Memo API; disabled until its own secret is configured.
TODO_BOT_BASE_URL=http://127.0.0.1:8787
TODO_BOT_SECRET=
# Default receipt-v1 requires {success:true, reply:"..."}.
# Existing to_do api/bot/message.ts uses {reply:"..."}; opt in only for that service.
TODO_BOT_RESPONSE_MODE=receipt-v1
# Todo may require binding, lookup and mutation round trips. One request, no retry.
TODO_BOT_TIMEOUT_MS=10000
# Durable Todo admission; use an absolute path on the gateway's private volume.
# Required in production. Empty leaves only the legacy in-process cache.
TODO_RECEIPTS_PATH=/home/node/.openclaw/jaxson-inbox/todo-receipts.sqlite
# Enable only after /api/bot/reminder-queue is deployed and WeChat is logged in.
TODO_REMINDERS_ENABLED=false
# Set once to the activation timestamp in UTC; do not move backwards on restart.
TODO_REMINDERS_SINCE=
