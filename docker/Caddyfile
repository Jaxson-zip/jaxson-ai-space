{$SITE_DOMAIN} {
    encode zstd gzip
    reverse_proxy portfolio:3000

    @page path / /index.html /config.js
    header @page >Cache-Control "no-store"
    @resume path /resume/zhang-jinpeng-ai-product-builder.pdf
    header @resume >Content-Disposition "attachment; filename=Jaxson-Resume.pdf"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    log {
        output stdout
        format json
    }
}

{$API_DOMAIN} {
    encode zstd gzip
    # The portfolio, CMS and indexing worker use REST. Chinese enum values in
    # the current collections cannot form a valid GraphQL schema.
    @unusedGraphQL path /api/graphql* /api/graphql-playground*
    respond @unusedGraphQL 404
    reverse_proxy web:3000 {
        # Caddy is the public edge in this deployment; these incoming headers
        # must not let a caller choose a different identity for rate limiting.
        header_up -CF-Connecting-IP
        header_up -Forwarded
        header_up -X-Real-IP
    }

    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    log {
        output stdout
        format json
    }
}
