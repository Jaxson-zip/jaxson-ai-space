{
    servers {
        # Public traffic arrives through Cloudflare (proxy or tunnel). Read the
        # visitor address only from these hops; a direct caller cannot set it.
        # Ranges: https://www.cloudflare.com/ips/ (review when Cloudflare changes them).
        trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

{$SITE_DOMAIN} {
    encode zstd gzip
    reverse_proxy portfolio:3000

    # Keep the portfolio server's Cache-Control and CDN-Cache-Control intact:
    # entry pages revalidate in browsers and may be cached briefly at the edge.
    @resume path /resume/zhang-jinpeng-ai-product-builder.pdf
    header @resume >Content-Disposition "attachment; filename=Jaxson-Resume.pdf"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    log {
        output stdout
        format json
    }
}

{$API_DOMAIN} {
    encode zstd gzip
    @chatBody path /api/chat
    request_body @chatBody {
        max_size 65536
    }
    # The portfolio, CMS and indexing worker use REST. Chinese enum values in
    # the current collections cannot form a valid GraphQL schema.
    @unusedGraphQL path /api/graphql* /api/graphql-playground*
    respond @unusedGraphQL 404
    reverse_proxy web:3000 {
        # The app rate-limits by X-Real-IP. Replace it with the address Caddy
        # resolved through trusted hops; drop the raw identity headers.
        header_up -CF-Connecting-IP
        header_up -Forwarded
        header_up X-Real-IP {client_ip}
    }

    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    log {
        output stdout
        format json
    }
}
