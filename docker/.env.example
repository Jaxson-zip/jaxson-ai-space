# Copy to docker/.env.production on the server. Use distinct hostnames without schemes.
SITE_DOMAIN=portfolio.example.com
API_DOMAIN=api.example.com
CADDY_BIND_IP=0.0.0.0

# Generate independent URL-safe random values, for example with openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-random-hex
OWNER_APP_PASSWORD=replace-with-different-random-hex
PUBLIC_AGENT_PASSWORD=replace-with-different-random-hex
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
STUDIO_SECRET_KEY=replace-with-different-random-secret
STUDIO_INBOX_SECRET=replace-with-different-random-secret
# Set actual IDs reported by your WeChat channel plugin; [] disables inbox writes.
STUDIO_INBOX_ALLOWED_IDENTITIES=[]
OWNER_EMAIL=owner@example.com
# Used by the private bootstrap job; keep in sync if you later change the CMS password.
OWNER_INITIAL_PASSWORD=replace-with-different-random-secret

# Optional: set both values if Cloudflare Access protects the Studio route.
CLOUDFLARE_ACCESS_TEAM_NAME=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_REQUIRED=false

# Optional: start the tunnel profile only after setting a real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional LLM provider. Without one, AI gives grounded local summaries.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Explicitly opt in to semantic indexing. The same settings apply to web and worker.
# Changing model/base URL requires running the maintenance reindex job.
EMBEDDING_MODE=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=5000

# Optional administrator password-reset email. 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Jaxson
